# Zonder sleutels draait alles op testproviders (nepbetaling, nepbeelden, nepdrukker).

# Publiek adres van de site, nodig voor de terugkeer na betalen en de webhook.
SITE_URL=http://localhost:3000

# Betalen: Mollie (iDEAL e.d.). Leeg = testbetaling op de site zelf.
MOLLIE_API_KEY=

# Drukker: Gelato. Leeg = nepdrukker (er wordt niets besteld).
GELATO_API_KEY=
GELATO_PRODUCT_UID_HARDCOVER=
GELATO_PRODUCT_UID_SOFTCOVER=

# Waar bestellingen en bestanden staan (lokaal). Voor productie: zie README.
DATA_DIR=.data
