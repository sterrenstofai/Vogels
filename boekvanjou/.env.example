# Zonder sleutels draait alles op de testversie: nepbetaling, testplaten, testdrukkers, geen mail.
# Elke regel hieronder zet één onderdeel op echt.

# Publiek adres van de site. Nodig voor betalen, mail en voor de beelddienst, die de foto hier ophaalt.
SITE_URL=http://localhost:3000
# Straks: SITE_URL=https://boekvanjou.nl

# Betalen: Mollie (iDEAL e.d.)
MOLLIE_API_KEY=

# Platen: Higgsfield-API (console.higgsfield.ai). Model staat standaard op Grok Image 2.0.
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
# HIGGSFIELD_MODEL=xai/grok-imagine-image-2.0

# Drukker: Gelato. De product-uid's komen uit hun productcatalogus (vierkant fotoboek 20 x 20 cm).
GELATO_API_KEY=
GELATO_PRODUCT_UID_HARDCOVER=
GELATO_PRODUCT_UID_SOFTCOVER=
# Geheim in het adres van de melding die de drukker stuurt: /api/webhooks/gelato?s=<geheim>
DRUKKER_WEBHOOK_SECRET=

# Mail: Resend. MAIL_VAN moet een adres zijn op een domein dat bij Resend is bevestigd.
RESEND_API_KEY=
MAIL_VAN=Boek van jou <boeken@boekvanjou.nl>

# Beheer: wie /beheer mag zien (e-mailadressen, door komma's gescheiden).
ADMIN_EMAILS=

# Geheim voor de achtergrondtaak die bestellingen doorzet en opruimt.
CRON_SECRET=

# Boek en omslag
# BOEK_MIN_BLADZIJDEN=30
# OMSLAG_RUG_MM=6
# OMSLAG_AFLOOP_MM=3

# Opslag: lokaal op schijf (DATA_DIR), op Netlify vanzelf in Netlify Blobs.
DATA_DIR=.data
